<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.Pane?>
<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="ant.gasmeter.Experiment.TabControl">
    <VBox styleClass="page">
        <!-- dark header band with title and status -->
        <HBox spacing="20.0" alignment="CENTER_LEFT" styleClass="hero-band">
            <padding>
                <Insets bottom="18.0" left="30.0" right="30.0" top="18.0"/>
            </padding>
            <Label text="Experiment" styleClass="hero-title"/>
            <Label fx:id="btStatus" text="inactive" styleClass="status-indicator"/>
        </HBox>
        <VBox spacing="20.0">
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
            </padding>
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Button text="Start Bluetooth Connection" onAction="#connect" styleClass="btn-primary"/>
                <Button text="Close BT Connection" onAction="#oncloseBT" styleClass="btn-ghost"/>
            </HBox>
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Button text="Export" onAction="#onExport" styleClass="btn-ghost"/>
                <Button text="Close Experiment" onAction="#onCloseExperiment" styleClass="btn-danger"/>
            </HBox>
            <VBox spacing="10.0" styleClass="card">
                <Label text="GAS VOLUME" styleClass="card-heading"/>
                <Pane fx:id="chartPane" prefWidth="700" prefHeight="320" minWidth="500" minHeight="300"/>
            </VBox>
            <VBox spacing="10.0" styleClass="card">
                <Label text="EXPERIMENT LOG" styleClass="card-heading"/>
                <TextArea fx:id="logArea" prefWidth="800" prefHeight="160" maxWidth="800" editable="false" promptText="experiment log" styleClass="log-area"/>
            </VBox>
        </VBox>
    </VBox>
</ScrollPane>
