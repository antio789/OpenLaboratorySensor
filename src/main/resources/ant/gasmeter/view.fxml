<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.HBox?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.image.ImageView?>
<?import java.lang.String?>


<?import java.lang.Integer?>
<TabPane xmlns:fx="http://javafx.com/fxml" fx:controller="ant.gasmeter.Controller" fx:id="tabPane">
    <Tab text="Dashboard" closable="false">
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <VBox styleClass="page">
                <!-- dark hero band with logo and title -->
                <HBox spacing="25.0" alignment="CENTER_LEFT" styleClass="dashboard-hero">
                    <ImageView fx:id="logoView" fitWidth="70" fitHeight="70" preserveRatio="true"/>
                    <VBox spacing="5.0">
                        <Label text="Gas Meter" styleClass="dashboard-hero-title"/>
                        <Label text="Open Sensors" styleClass="dashboard-hero-subtitle"/>
                    </VBox>
                </HBox>
                <VBox fx:id="dashboardRoot" spacing="15.0" styleClass="dashboard-body">
                    <VBox fx:id="experimentsContainer" spacing="15.0"/>
                    <Label fx:id="noExperimentsLabel" text="No experiments running. Create one in the New Experiment tab." styleClass="dashboard-hint"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </Tab>
    <Tab text="New Experiment" closable="false">
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <VBox spacing="20.0">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                </padding>
                <VBox spacing="10.0">
                    <Label text="Experiment Name:"/>
                    <TextField fx:id="experimentNameField" promptText="Enter experiment name" maxWidth="300"/>
                </VBox>
                <VBox spacing="10.0">
                    <Label text="Bluetooth Device: Please scan and select a device or write manually"/>
                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                        <Label text="MAC Address:"/>
                        <TextField fx:id="macField" promptText="MAC address" maxWidth="200"/>
                        <Button text="Scan for device" onAction="#onBLEScanClick" maxWidth="150"/>
                    </HBox>
                </VBox>
                <VBox spacing="10.0">
                    <Label text="Number of Sensors:"/>
                    <ComboBox fx:id="sensorCountCombo" onAction="#onSensorCountSelected" maxWidth="100">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <Integer fx:value="1"/>
                                <Integer fx:value="2"/>
                                <Integer fx:value="3"/>
                                <Integer fx:value="4"/>
                                <Integer fx:value="5"/>
                            </FXCollections>
                        </items>
                    </ComboBox>
                </VBox>
                <VBox fx:id="sensorFieldsContainer" spacing="10.0"/>
                <CheckBox fx:id="saveConfigCheck" text="Save configuration for future use?"/>
                <HBox spacing="10">
                    <Button text="Continue" onAction="#onContinueClick" maxWidth="200"/>
                    <Button text="Load Configuration" onAction="#onLoadConfigClick" maxWidth="200"/>
                </HBox>
                <Label fx:id="validationLabel"/>

            </VBox>
        </ScrollPane>
    </Tab>
</TabPane>
